<?xml version="1.0"?>
<launch>

  <!-- Shared parameter file for all nodes -->
  <arg name="config_file" default="$(find-pkg-share toy_robot)/config/robot_config.yaml" description="Path to ROS2 parameter file"/>

  <!-- Brain node -->
  <node pkg="toy_robot" exec="brain_node" name="brain_node" output="screen">
    <param from="$(var config_file)"/>
  </node>

  <!-- Perception node -->
  <node pkg="toy_robot" exec="perception_node" name="perception_node" output="screen">
    <param from="$(var config_file)"/>
  </node>

  <!-- Manipulation action server node -->
  <node pkg="toy_robot" exec="manipulation_node" name="manipulation_node" output="screen">
    <param from="$(var config_file)"/>
  </node>

</launch>
