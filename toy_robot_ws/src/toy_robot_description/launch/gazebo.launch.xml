<launch>

    <!-- Arguments -->
    <arg name="model" default="$(find-pkg-share toy_robot_description)/urdf/toy_robot.urdf.xacro" />
    <arg name="world" default="$(find-pkg-share toy_robot_description)/worlds/toy_robot_world.sdf"
        description="Gazebo built-in world name, or absolute path to a .sdf file" />
    <arg name="rviz" default="true"
        description="Set to false to skip RViz" />
    <arg name="x" default="0.0" />
    <arg name="y" default="0.0" />
    <arg name="z" default="0.06" />

    <!-- 1. Gazebo Harmonic: -r = run immediately (no pause on start) -->
    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-r $(var world)" />
    </include>

    <!-- 2. robot_state_publisher -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(command 'xacro $(var model)')" />
        <param name="ignore_timestamp" value="true" />
        <param name="publish_frequency" value="30.0" />
        <param name="use_sim_time" value="true" />
    </node>

    <!-- 3. Spawn the robot in Gazebo -->
    <node
        pkg="ros_gz_sim"
        exec="create"
        name="spawn_toy_robot"
        output="screen"
        args="-name toy_robot
              -topic /robot_description
              -x $(var x)
              -y $(var y)
              -z $(var z)" />

    <!-- 4. ros_gz_bridge -->
    <node
        pkg="ros_gz_bridge"
        exec="parameter_bridge"
        name="ros_gz_bridge"
        output="screen"
        args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock
              /cmd_vel@geometry_msgs/msg/Twist]gz.msgs.Twist
              /odom@nav_msgs/msg/Odometry[gz.msgs.Odometry
              /tf@tf2_msgs/msg/TFMessage[gz.msgs.Pose_V
              /joint_states@sensor_msgs/msg/JointState[gz.msgs.Model
              /camera/image_raw@sensor_msgs/msg/Image[gz.msgs.Image
              /camera/camera_info@sensor_msgs/msg/CameraInfo[gz.msgs.CameraInfo">
        <param name="use_sim_time" value="true" />
    </node>

    <!-- 5. RViz (optional, set rviz:=false to skip) -->
    <node pkg="rviz2" exec="rviz2" output="screen" if="$(var rviz)">
        <param name="use_sim_time" value="true" />
    </node>

</launch>