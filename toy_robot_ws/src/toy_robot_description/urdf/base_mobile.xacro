<?xml version="1.0"?>
<robot name="toy_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <link name="base_footprint" />

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    </joint>

    <link name="base_link">
        <visual>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
            <geometry>
                <cylinder length="${base_height}" radius="${base_radius}" />
            </geometry>
            <material name="black">
                <color rgba="0.1 0.1 0.1 1.0" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
            <geometry>
                <cylinder length="${base_height}" radius="${base_radius}" />
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
            <mass value="${base_mass}" />
            <inertia
                ixx="${base_mass * (3 * base_radius * base_radius + base_height * base_height) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${base_mass * (3 * base_radius * base_radius + base_height * base_height) / 12}"
                iyz="0.0"
                izz="${base_mass * base_radius * base_radius / 2}" />
        </inertial>
    </link>

</robot>