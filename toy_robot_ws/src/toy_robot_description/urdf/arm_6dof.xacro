<?xml version="1.0"?>
<robot name="toy_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="arm_joint_1" type="revolute">
        <parent link="base_link" />
        <child link="shoulder_link" />
        <origin xyz="${arm_mount_x} 0 ${arm_mount_z}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="1.0" lower="-3.14" upper="3.14" />
    </joint>

    <link name="shoulder_link">
        <visual>
            <geometry>
                <cylinder length="${shoulder_length}" radius="${shoulder_radius}" />
            </geometry>
            <origin xyz="0 0 ${shoulder_length/2}" rpy="0 0 0" />
            <material name="arm_joint">
                <color rgba="${color_joint}" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="${shoulder_length}" radius="${shoulder_radius}" />
            </geometry>
            <origin xyz="0 0 ${shoulder_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${shoulder_length/2}" rpy="0 0 0" />
            <mass value="${shoulder_mass}" />
            <inertia
                ixx="${shoulder_mass * (3 * shoulder_radius * shoulder_radius + shoulder_length * shoulder_length) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${shoulder_mass * (3 * shoulder_radius * shoulder_radius + shoulder_length * shoulder_length) / 12}"
                iyz="0.0"
                izz="${shoulder_mass * shoulder_radius * shoulder_radius / 2}" />
        </inertial>
    </link>

    <joint name="arm_joint_2" type="revolute">
        <parent link="shoulder_link" />
        <child link="arm_link" />
        <origin xyz="0 0 ${shoulder_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="1.0" lower="-1.57" upper="1.57" />
    </joint>

    <link name="arm_link">
        <visual>
            <geometry>
                <cylinder length="${arm_length}" radius="${arm_radius}" />
            </geometry>
            <origin xyz="0 0 ${arm_length/2}" rpy="0 0 0" />
            <material name="arm_link1">
                <color rgba="${color_link}" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="${arm_length}" radius="${arm_radius}" />
            </geometry>
            <origin xyz="0 0 ${arm_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${arm_length/2}" rpy="0 0 0" />
            <mass value="${arm_mass}" />
            <inertia
                ixx="${arm_mass * (3 * arm_radius * arm_radius + arm_length * arm_length) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${arm_mass * (3 * arm_radius * arm_radius + arm_length * arm_length) / 12}"
                iyz="0.0"
                izz="${arm_mass * arm_radius * arm_radius / 2}" />
        </inertial>
    </link>

    <joint name="arm_joint_3" type="revolute">
        <parent link="arm_link" />
        <child link="elbow_link" />
        <origin xyz="0 0 ${arm_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="1.0" lower="-1.57" upper="1.57" />
    </joint>

    <link name="elbow_link">
        <visual>
            <geometry>
                <cylinder length="${elbow_length}" radius="${elbow_radius}" />
            </geometry>
            <origin xyz="0 0 ${elbow_length/2}" rpy="0 0 0" />
            <material name="arm_joint2">
                <color rgba="${color_joint}" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="${elbow_length}" radius="${elbow_radius}" />
            </geometry>
            <origin xyz="0 0 ${elbow_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${elbow_length/2}" rpy="0 0 0" />
            <mass value="${elbow_mass}" />
            <inertia
                ixx="${elbow_mass * (3 * elbow_radius * elbow_radius + elbow_length * elbow_length) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${elbow_mass * (3 * elbow_radius * elbow_radius + elbow_length * elbow_length) / 12}"
                iyz="0.0"
                izz="${elbow_mass * elbow_radius * elbow_radius / 2}" />
        </inertial>
    </link>

    <joint name="arm_joint_4" type="revolute">
        <parent link="elbow_link" />
        <child link="forearm_link" />
        <origin xyz="0 0 ${elbow_length}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="1000.0" velocity="1.0" lower="-3.14" upper="3.14" />
    </joint>

    <link name="forearm_link">
        <visual>
            <geometry>
                <cylinder length="${forearm_length}" radius="${forearm_radius}" />
            </geometry>
            <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0" />
            <material name="arm_link2">
                <color rgba="${color_link}" />
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder length="${forearm_length}" radius="${forearm_radius}" />
            </geometry>
            <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${forearm_length/2}" rpy="0 0 0" />
            <mass value="${forearm_mass}" />
            <inertia
                ixx="${forearm_mass * (3 * forearm_radius * forearm_radius + forearm_length * forearm_length) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${forearm_mass * (3 * forearm_radius * forearm_radius + forearm_length * forearm_length) / 12}"
                iyz="0.0"
                izz="${forearm_mass * forearm_radius * forearm_radius / 2}" />
        </inertial>
    </link>

    <joint name="arm_joint_5" type="revolute">
        <parent link="forearm_link" />
        <child link="wrist_link" />
        <origin xyz="0 0 ${forearm_length}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="1000.0" velocity="1.0" lower="-1.57" upper="1.57" />
    </joint>

    <link name="wrist_link">
        <visual>
            <geometry>
                <box size="${wrist_size_x} ${wrist_size_y} ${wrist_height}" />
            </geometry>
            <origin xyz="0 0 ${wrist_height/2}" rpy="0 0 0" />
            <material name="arm_joint3">
                <color rgba="${color_joint}" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${wrist_size_x} ${wrist_size_y} ${wrist_height}" />
            </geometry>
            <origin xyz="0 0 ${wrist_height/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${wrist_height/2}" rpy="0 0 0" />
            <mass value="${wrist_mass}" />
            <inertia
                ixx="${wrist_mass * (wrist_size_y * wrist_size_y + wrist_height * wrist_height) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${wrist_mass * (wrist_size_x * wrist_size_x + wrist_height * wrist_height) / 12}"
                iyz="0.0"
                izz="${wrist_mass * (wrist_size_x * wrist_size_x + wrist_size_y * wrist_size_y) / 12}" />
        </inertial>
    </link>

    <joint name="arm_joint_6" type="continuous">
        <parent link="wrist_link" />
        <child link="hand_link" />
        <origin xyz="0 0 ${wrist_height}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>

    <link name="hand_link">
        <visual>
            <geometry>
                <box size="${hand_size_x} ${hand_size_y} ${hand_height}" />
            </geometry>
            <origin xyz="0 0 ${hand_height/2}" rpy="0 0 0" />
            <material name="arm_link3">
                <color rgba="${color_link}" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${hand_size_x} ${hand_size_y} ${hand_height}" />
            </geometry>
            <origin xyz="0 0 ${hand_height/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${hand_height/2}" rpy="0 0 0" />
            <mass value="${hand_mass}" />
            <inertia
                ixx="${hand_mass * (hand_size_y * hand_size_y + hand_height * hand_height) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${hand_mass * (hand_size_x * hand_size_x + hand_height * hand_height) / 12}"
                iyz="0.0"
                izz="${hand_mass * (hand_size_x * hand_size_x + hand_size_y * hand_size_y) / 12}" />
        </inertial>
    </link>

    <joint name="hand_tool_joint" type="fixed">
        <parent link="hand_link" />
        <child link="gripper_mount_link" />
        <origin xyz="0 0 ${hand_height}" rpy="0 0 0" />
    </joint>

    <link name="gripper_mount_link" />

</robot>