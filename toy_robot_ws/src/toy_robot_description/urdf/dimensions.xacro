<?xml version="1.0"?>
<robot name="toy_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Base -->
    <xacro:property name="base_radius" value="0.2" />
    <xacro:property name="base_height" value="0.1" />
    <xacro:property name="base_mass" value="2.0" />

    <!-- Camera -->
    <xacro:property name="camera_size_x" value="0.03" />
    <xacro:property name="camera_size_y" value="0.05" />
    <xacro:property name="camera_size_z" value="0.022" />
    <xacro:property name="camera_mass" value="0.07" />
    <xacro:property name="camera_mount_x" value="${base_radius}" />
    <xacro:property name="camera_mount_z" value="${base_height/2}" />

    <!-- Arm -->
    <xacro:property name="shoulder_length" value="0.06" />
    <xacro:property name="arm_length" value="0.14" />
    <xacro:property name="elbow_length" value="0.04" />
    <xacro:property name="forearm_length" value="0.12" />
    <xacro:property name="wrist_height" value="0.03" />
    <xacro:property name="wrist_size_x" value="0.04" />
    <xacro:property name="wrist_size_y" value="0.04" />
    <xacro:property name="hand_height" value="0.02" />
    <xacro:property name="hand_size_x" value="0.05" />
    <xacro:property name="hand_size_y" value="0.05" />

    <xacro:property name="shoulder_radius" value="0.020" />
    <xacro:property name="arm_radius" value="0.015" />
    <xacro:property name="elbow_radius" value="0.022" />
    <xacro:property name="forearm_radius" value="0.013" />

    <xacro:property name="shoulder_mass" value="0.12" />
    <xacro:property name="arm_mass" value="0.18" />
    <xacro:property name="elbow_mass" value="0.08" />
    <xacro:property name="forearm_mass" value="0.12" />
    <xacro:property name="wrist_mass" value="0.06" />
    <xacro:property name="hand_mass" value="0.05" />

    <xacro:property name="arm_mount_x" value="${0.4 * base_radius}" />
    <xacro:property name="arm_mount_z" value="${base_height}" />

    <!-- Gripper -->
    <xacro:property name="palm_x" value="0.05" />
    <xacro:property name="palm_y" value="0.04" />
    <xacro:property name="palm_z" value="0.02" />
    <xacro:property name="palm_mass" value="0.04" />

    <xacro:property name="finger_x" value="0.015" />
    <xacro:property name="finger_y" value="0.008" />
    <xacro:property name="finger_z" value="0.045" />
    <xacro:property name="finger_mass" value="0.015" />

    <xacro:property name="finger_y_offset" value="0.02" />
    <xacro:property name="finger_open_max" value="0.025" />

    <!-- LiDAR -->
    <xacro:property name="lidar_radius" value="0.032" />
    <xacro:property name="lidar_size_z" value="0.038" />
    <xacro:property name="lidar_mass" value="0.16" />

    <!-- Wheels -->
    <xacro:property name="wheel_radius" value="0.05" />
    <xacro:property name="wheel_width" value="0.03" />
    <xacro:property name="wheel_mass" value="0.1" />
    <xacro:property name="caster_radius" value="0.02" />
    <xacro:property name="caster_mass" value="0.05" />
    <!-- wheel axle Y: just outside the base cylinder -->
    <xacro:property name="wheel_y" value="${base_radius + wheel_width/2}" />

    <!-- Colors (RGBA) -->
    <!-- joints: dark steel -->
    <xacro:property name="color_joint" value="0.45 0.45 0.48 1.0" />
    <!-- links: light gray -->
    <xacro:property name="color_link" value="0.65 0.65 0.65 1.0" />
    <!-- camera: near white -->
    <xacro:property name="color_camera" value="0.88 0.88 0.88 1.0" />
    <!-- lidar: dark gray -->
    <xacro:property name="color_lidar" value="0.25 0.25 0.25 1.0" />
    <!-- rubber dark -->
    <xacro:property name="color_wheel" value="0.15 0.15 0.15 1.0" />

</robot>