<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>toy_robot_bringup</name>
    <version>0.0.0</version>
    <description>Top-level bringup package for toy_robot: simulation, SLAM, and navigation launch
        files.</description>
    <maintainer email="gabrielyakpaoro@gmail.com">gabrielgamy</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <!-- Description package for URDF, worlds, and Gazebo config -->
    <exec_depend>toy_robot_description</exec_depend>

    <!-- Simulation -->
    <exec_depend>ros_gz_sim</exec_depend>
    <exec_depend>ros_gz_bridge</exec_depend>
    <exec_depend>robot_state_publisher</exec_depend>
    <exec_depend>rviz2</exec_depend>

    <!-- SLAM -->
    <exec_depend>slam_toolbox</exec_depend>

    <!-- Navigation -->
    <exec_depend>nav2_bringup</exec_depend>
    <exec_depend>nav2_amcl</exec_depend>
    <exec_depend>nav2_map_server</exec_depend>
    <exec_depend>nav2_lifecycle_manager</exec_depend>

    <!-- Launch system -->
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>launch_xml</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>