<launch>

    <!-- Arguments -->
    <arg name="rviz" default="true" description="Launch RViz" />
    <arg name="use_sim_time" default="true" description="Use Gazebo simulation clock" />
    <arg name="spawn_x" default="-2.0" description="Robot spawn x position in Gazebo" />
    <arg name="spawn_y" default="0.0" description="Robot spawn y position in Gazebo" />
    <arg name="spawn_z" default="0.10" description="Robot spawn z position in Gazebo" />
    <arg name="slam_params_file"
        default="$(find-pkg-share toy_robot_bringup)/config/slam_params.yaml"
        description="Path to slam_toolbox parameters file" />

    <!-- 1. Gazebo simulation (no RViz, launched below with SLAM config) -->
    <include file="$(find-pkg-share toy_robot_description)/launch/gazebo.launch.xml">
        <arg name="rviz" value="false" />
        <arg name="x" value="$(var spawn_x)" />
        <arg name="y" value="$(var spawn_y)" />
        <arg name="z" value="$(var spawn_z)" />
    </include>

    <!-- 2. SLAM Toolbox, online asynchronous mode -->
    <include file="$(find-pkg-share slam_toolbox)/launch/online_async_launch.py">
        <arg name="use_sim_time" value="$(var use_sim_time)" />
        <arg name="slam_params_file" value="$(var slam_params_file)" />
    </include>

    <!-- 3. RViz with SLAM config (map + scan + robot model) -->
    <node pkg="rviz2" exec="rviz2" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)" />
    </node>

</launch>