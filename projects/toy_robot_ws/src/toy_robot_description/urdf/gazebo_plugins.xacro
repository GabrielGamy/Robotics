<?xml version="1.0"?>
<robot name="toy_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Gazebo material tags -->
    <!-- Gazebo ignores URDF material tags and needs its own per-link entries -->

    <gazebo reference="base_link">
        <visual>
            <material>
                <ambient>0.1 0.1 0.1 1</ambient>
                <diffuse>0.1 0.1 0.1 1</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="left_wheel_link">
        <visual>
            <material>
                <ambient>${color_wheel}</ambient>
                <diffuse>${color_wheel}</diffuse>
            </material>
        </visual>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e6</kp>
        <kd>1.0</kd>
    </gazebo>

    <gazebo reference="right_wheel_link">
        <visual>
            <material>
                <ambient>${color_wheel}</ambient>
                <diffuse>${color_wheel}</diffuse>
            </material>
        </visual>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e6</kp>
        <kd>1.0</kd>
    </gazebo>

    <gazebo reference="caster_link">
        <!-- Low friction so caster can swivel freely -->
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
    </gazebo>

    <gazebo reference="camera_link">
        <visual>
            <material>
                <ambient>0.88 0.88 0.88 1</ambient>
                <diffuse>0.88 0.88 0.88 1</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="shoulder_link">
        <gravity>false</gravity>
        <visual>
            <material>
                <ambient>${color_joint}</ambient>
                <diffuse>${color_joint}</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="arm_link">
        <gravity>false</gravity>
        <visual>
            <material>
                <ambient>${color_link}</ambient>
                <diffuse>${color_link}</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="elbow_link">
        <gravity>false</gravity>
        <visual>
            <material>
                <ambient>${color_joint}</ambient>
                <diffuse>${color_joint}</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="forearm_link">
        <gravity>false</gravity>
        <visual>
            <material>
                <ambient>${color_link}</ambient>
                <diffuse>${color_link}</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="wrist_link">
        <gravity>false</gravity>
        <visual>
            <material>
                <ambient>${color_joint}</ambient>
                <diffuse>${color_joint}</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="hand_link">
        <gravity>false</gravity>
        <visual>
            <material>
                <ambient>${color_link}</ambient>
                <diffuse>${color_link}</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="gripper_palm_link">
        <gravity>false</gravity>
        <visual>
            <material>
                <ambient>0.4 0.4 0.4 1</ambient>
                <diffuse>0.4 0.4 0.4 1</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="gripper_left_link">
        <gravity>false</gravity>
        <visual>
            <material>
                <ambient>0.6 0.6 0.6 1</ambient>
                <diffuse>0.6 0.6 0.6 1</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="gripper_right_link">
        <gravity>false</gravity>
        <visual>
            <material>
                <ambient>0.6 0.6 0.6 1</ambient>
                <diffuse>0.6 0.6 0.6 1</diffuse>
            </material>
        </visual>
    </gazebo>

    <!-- Differential drive plugin for mobile base -->
    <!-- Publishes /odom and subscribes to /cmd_vel -->
    <!-- wheel_separation = 2 * wheel_y = 2 * (base_radius + wheel_width/2) -->
    <gazebo>
        <plugin filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>${2 * wheel_y}</wheel_separation>
            <wheel_radius>${wheel_radius}</wheel_radius>
            <max_linear_acceleration>0.25</max_linear_acceleration>
            <min_linear_acceleration>-0.25</min_linear_acceleration>
            <max_angular_acceleration>0.9</max_angular_acceleration>
            <min_angular_acceleration>-0.9</min_angular_acceleration>
            <odom_publish_frequency>20</odom_publish_frequency>
            <topic>/cmd_vel</topic>
            <odom_topic>/odom</odom_topic>
            <tf_topic>/tf</tf_topic>
            <frame_id>odom</frame_id>
            <child_frame_id>base_footprint</child_frame_id>
        </plugin>
    </gazebo>

    <!-- Joint state publisher - broadcasts all joint positions -->
    <!-- Allows robot_state_publisher to compute full TF tree -->
    <!-- (arm, gripper) in both RViz and ROS nodes -->
    <gazebo>
        <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>/joint_states</topic>
        </plugin>
    </gazebo>

    <!-- 2D LiDAR sensor for Nav2 navigation -->
    <!-- Mounted on top center of robot -->
    <!-- Publishes to /scan (bridged via ros_gz_bridge) -->
    <!-- Requires gz-sim-sensors-system loaded at world level -->
    <gazebo reference="lidar_link">
        <sensor name="lidar_sensor" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1</resolution>
                        <min_angle>0</min_angle>
                        <max_angle>6.28318</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.08</min>
                    <max>10.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
            <always_on>true</always_on>
            <update_rate>10</update_rate>
            <visualize>false</visualize>
            <topic>/scan</topic>
            <gz_frame_id>lidar_link</gz_frame_id>
        </sensor>
    </gazebo>

    <!-- Camera sensor RGB image -->
    <!-- Mounted on front of robot -->
    <!-- Publishes to /camera/image_raw (bridged via ros_gz_bridge) -->
    <!-- Requires gz-sim-sensors-system loaded at world level -->
    <gazebo reference="camera_link">
        <sensor name="camera_sensor" type="camera">
            <pose>0 0 ${camera_size_z} 0 0 0</pose>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <always_on>true</always_on>
            <update_rate>30</update_rate>
            <visualize>true</visualize>
            <topic>/camera/image_raw</topic>
        </sensor>
    </gazebo>

</robot>