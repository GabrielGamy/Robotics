<?xml version="1.0"?>
<robot name="toy_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Paume de la pince, attachee a gripper_mount_link -->
    <joint name="gripper_palm_joint" type="fixed">
        <parent link="gripper_mount_link" />
        <child link="gripper_palm_link" />
        <origin xyz="0 0 0.01" rpy="0 0 0" />
    </joint>

    <link name="gripper_palm_link">
        <visual>
            <geometry>
                <box size="${palm_x} ${palm_y} ${palm_z}" />
            </geometry>
            <origin xyz="0 0 ${palm_z/2}" rpy="0 0 0" />
            <material name="gripper_gray">
                <color rgba="0.4 0.4 0.4 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${palm_x} ${palm_y} ${palm_z}" />
            </geometry>
            <origin xyz="0 0 ${palm_z/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${palm_z/2}" rpy="0 0 0" />
            <mass value="${palm_mass}" />
            <inertia
                ixx="${palm_mass * (palm_y * palm_y + palm_z * palm_z) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${palm_mass * (palm_x * palm_x + palm_z * palm_z) / 12}"
                iyz="0.0"
                izz="${palm_mass * (palm_x * palm_x + palm_y * palm_y) / 12}" />
        </inertial>
    </link>

    <!-- Doigt gauche (glisse vers +y) -->
    <joint name="gripper_left_joint" type="prismatic">
        <parent link="gripper_palm_link" />
        <child link="gripper_left_link" />
        <origin xyz="0 ${finger_y_offset} ${palm_z}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <dynamics damping="10.0" friction="5.0" />
        <limit effort="100.0" velocity="0.5" lower="0.0" upper="${finger_open_max}" />
    </joint>

    <link name="gripper_left_link">
        <visual>
            <geometry>
                <box size="${finger_x} ${finger_y} ${finger_z}" />
            </geometry>
            <origin xyz="0 0 ${finger_z/2}" rpy="0 0 0" />
            <material name="gripper_finger">
                <color rgba="0.6 0.6 0.6 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${finger_x} ${finger_y} ${finger_z}" />
            </geometry>
            <origin xyz="0 0 ${finger_z/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${finger_z/2}" rpy="0 0 0" />
            <mass value="${finger_mass}" />
            <inertia
                ixx="${finger_mass * (finger_y * finger_y + finger_z * finger_z) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${finger_mass * (finger_x * finger_x + finger_z * finger_z) / 12}"
                iyz="0.0"
                izz="${finger_mass * (finger_x * finger_x + finger_y * finger_y) / 12}" />
        </inertial>
    </link>

    <!-- Doigt droit (glisse vers -y) -->
    <joint name="gripper_right_joint" type="prismatic">
        <parent link="gripper_palm_link" />
        <child link="gripper_right_link" />
        <origin xyz="0 -${finger_y_offset} ${palm_z}" rpy="0 0 0" />
        <axis xyz="0 -1 0" />
        <dynamics damping="10.0" friction="5.0" />
        <limit effort="100.0" velocity="0.5" lower="0.0" upper="${finger_open_max}" />
    </joint>

    <link name="gripper_right_link">
        <visual>
            <geometry>
                <box size="${finger_x} ${finger_y} ${finger_z}" />
            </geometry>
            <origin xyz="0 0 ${finger_z/2}" rpy="0 0 0" />
            <material name="gripper_finger">
                <color rgba="0.6 0.6 0.6 1.0" />
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${finger_x} ${finger_y} ${finger_z}" />
            </geometry>
            <origin xyz="0 0 ${finger_z/2}" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 ${finger_z/2}" rpy="0 0 0" />
            <mass value="${finger_mass}" />
            <inertia
                ixx="${finger_mass * (finger_y * finger_y + finger_z * finger_z) / 12}"
                ixy="0.0" ixz="0.0"
                iyy="${finger_mass * (finger_x * finger_x + finger_z * finger_z) / 12}"
                iyz="0.0"
                izz="${finger_mass * (finger_x * finger_x + finger_y * finger_y) / 12}" />
        </inertial>
    </link>

    <!-- Frame TCP au bout des doigts -->
    <joint name="tcp_joint" type="fixed">
        <parent link="gripper_palm_link" />
        <child link="tcp_link" />
        <origin xyz="0 0 ${palm_z + finger_z}" rpy="0 0 0" />
    </joint>

    <link name="tcp_link" />

</robot>