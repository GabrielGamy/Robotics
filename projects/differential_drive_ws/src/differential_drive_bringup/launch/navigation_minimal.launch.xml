<launch>
    <!-- Pose-goal navigation only: omit route, waypoint-follower, and docking servers
         from both startup and lifecycle management. Keep this subset in XML. -->
    <arg name="params_file"
        default="$(find-pkg-share differential_drive_bringup)/config/nav2_params.yaml" />
    <arg name="use_sim_time" default="true" />
    <arg name="autostart" default="true" />
    <arg name="use_respawn" default="false" />
    <arg name="log_level" default="info" />

    <set_env name="RCUTILS_LOGGING_BUFFERED_STREAM" value="1" />

    <node pkg="nav2_controller" exec="controller_server" name="controller_server"
        output="screen" respawn="$(var use_respawn)" respawn_delay="2.0"
        args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <remap from="/tf" to="tf" />
        <remap from="/tf_static" to="tf_static" />
        <remap from="cmd_vel" to="cmd_vel_nav" />
    </node>

    <node pkg="nav2_smoother" exec="smoother_server" name="smoother_server"
        output="screen" respawn="$(var use_respawn)" respawn_delay="2.0"
        args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <remap from="/tf" to="tf" />
        <remap from="/tf_static" to="tf_static" />
    </node>

    <node pkg="nav2_planner" exec="planner_server" name="planner_server"
        output="screen" respawn="$(var use_respawn)" respawn_delay="2.0"
        args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <remap from="/tf" to="tf" />
        <remap from="/tf_static" to="tf_static" />
    </node>

    <node pkg="nav2_behaviors" exec="behavior_server" name="behavior_server"
        output="screen" respawn="$(var use_respawn)" respawn_delay="2.0"
        args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <remap from="/tf" to="tf" />
        <remap from="/tf_static" to="tf_static" />
        <remap from="cmd_vel" to="cmd_vel_nav" />
    </node>

    <node pkg="nav2_bt_navigator" exec="bt_navigator" name="bt_navigator"
        output="screen" respawn="$(var use_respawn)" respawn_delay="2.0"
        args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <remap from="/tf" to="tf" />
        <remap from="/tf_static" to="tf_static" />
    </node>

    <node pkg="nav2_velocity_smoother" exec="velocity_smoother" name="velocity_smoother"
        output="screen" respawn="$(var use_respawn)" respawn_delay="2.0"
        args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <remap from="/tf" to="tf" />
        <remap from="/tf_static" to="tf_static" />
        <remap from="cmd_vel" to="cmd_vel_nav" />
    </node>

    <node pkg="nav2_collision_monitor" exec="collision_monitor" name="collision_monitor"
        output="screen" respawn="$(var use_respawn)" respawn_delay="2.0"
        args="--ros-args --log-level $(var log_level)">
        <param from="$(var params_file)" />
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <remap from="/tf" to="tf" />
        <remap from="/tf_static" to="tf_static" />
    </node>

    <node pkg="nav2_lifecycle_manager" exec="lifecycle_manager"
        name="lifecycle_manager_navigation" output="screen"
        args="--ros-args --log-level $(var log_level)">
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <param name="autostart" value="$(var autostart)" />
        <param name="node_names"
            value="['controller_server', 'smoother_server', 'planner_server', 'behavior_server', 'velocity_smoother', 'collision_monitor', 'bt_navigator']" />
    </node>
</launch>