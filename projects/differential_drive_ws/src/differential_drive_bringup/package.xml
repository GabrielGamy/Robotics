  <maintainer email="gabrielyakpaoro@gmail.com">gabrielgamy</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>differential_drive_robot</exec_depend>
