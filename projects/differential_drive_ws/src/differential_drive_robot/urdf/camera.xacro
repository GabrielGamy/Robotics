<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:macro name="camera_visuals" params="">
        <xacro:property name="housing_front"
            value="${camera_mount_x + camera_mount_depth + camera_body_depth}" />

        <visual name="camera_mount_plate">
            <origin xyz="${camera_mount_x + camera_mount_depth/2} 0 ${camera_mount_z}"
                rpy="0 0 0" />
            <geometry>
                <box
                    size="${camera_mount_depth} ${camera_body_width + 0.008} ${camera_body_height + 0.008}" />
            </geometry>
            <material name="gray" />
        </visual>

        <visual name="camera_housing">
            <origin
                xyz="${camera_mount_x + camera_mount_depth + camera_body_depth/2} 0 ${camera_mount_z}"
                rpy="0 0 0" />
            <geometry>
                <box size="${camera_body_depth} ${camera_body_width} ${camera_body_height}" />
            </geometry>
            <material name="black" />
        </visual>

        <visual name="camera_lens_bezel">
            <origin xyz="${housing_front + 0.0015} 0 ${camera_mount_z}" rpy="0 ${pi/2} 0" />
            <geometry>
                <cylinder radius="${camera_lens_radius + 0.003}" length="0.003" />
            </geometry>
            <material name="gray" />
        </visual>

        <visual name="camera_lens_barrel">
            <origin xyz="${housing_front + camera_lens_depth/2} 0 ${camera_mount_z}"
                rpy="0 ${pi/2} 0" />
            <geometry>
                <cylinder radius="${camera_lens_radius}" length="${camera_lens_depth}" />
            </geometry>
            <material name="black" />
        </visual>

        <visual name="camera_lens_glass">
            <origin xyz="${housing_front + camera_lens_depth + 0.0005} 0 ${camera_mount_z}"
                rpy="0 ${pi/2} 0" />
            <geometry>
                <cylinder radius="${camera_lens_radius - 0.002}" length="0.001" />
            </geometry>
            <material name="camera_glass">
                <color rgba="0.08 0.28 0.40 1.0" />
            </material>
        </visual>
    </xacro:macro>

    <link name="camera_link" />
    <joint name="base_link_to_camera_joint" type="fixed">
        <parent link="base_link" />
        <child link="camera_link" />
        <origin xyz="${camera_sensor_x} 0 ${camera_mount_z}" rpy="0 0 0" />
    </joint>

    <link name="camera_optical_frame" />
    <joint name="camera_to_optical_joint" type="fixed">
        <parent link="camera_link" />
        <child link="camera_optical_frame" />
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
    </joint>
</robot>