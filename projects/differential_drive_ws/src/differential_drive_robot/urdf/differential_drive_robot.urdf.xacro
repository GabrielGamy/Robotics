<?xml version="1.0"?>
<robot name="differential_drive_robot" xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:arg name="lidar_profile" default="balanced" />
    <xacro:property name="lidar_profile_value" value="$(arg lidar_profile)" />

    <xacro:include filename="properties.xacro" />
    <xacro:include filename="materials.xacro" />
    <xacro:include filename="jetson.xacro" />
    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="camera.xacro" />
    <xacro:include filename="base.xacro" />
    <xacro:include filename="sensors.xacro" />
    <xacro:include filename="wheels.xacro" />
    <xacro:include filename="caster.xacro" />
    <xacro:include filename="gazebo_plugins.xacro" />
    <xacro:include filename="ros2_control.xacro" />

</robot>