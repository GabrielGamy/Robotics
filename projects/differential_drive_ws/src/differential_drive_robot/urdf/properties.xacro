<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:property name="wheel_radius" value="0.06" />
    <xacro:property name="wheel_width" value="0.04" />
    <xacro:property name="wheel_separation" value="0.28" />
    <xacro:property name="base_length" value="0.40" />
    <xacro:property name="base_width" value="0.25" />
    <xacro:property name="base_height" value="0.08" />
    <xacro:property name="caster_radius" value="0.03" />

    <xacro:property name="base_mass" value="1.5" />
    <xacro:property name="wheel_mass" value="0.4" />
    <xacro:property name="caster_mass" value="0.15" />

    <xacro:property name="base_inertia_ixx" value="0.01" />
    <xacro:property name="base_inertia_iyy" value="0.02" />
    <xacro:property name="base_inertia_izz" value="0.02" />

    <xacro:property name="wheel_inertia_ixx" value="0.0008" />
    <xacro:property name="wheel_inertia_iyy" value="0.0014" />
    <xacro:property name="wheel_inertia_izz" value="0.0008" />

    <xacro:property name="caster_inertia_ixx" value="0.0002" />
    <xacro:property name="caster_inertia_iyy" value="0.0002" />
    <xacro:property name="caster_inertia_izz" value="0.0002" />

    <xacro:property name="lidar_is_light" value="${lidar_profile_value == 'light'}" />
    <xacro:property name="lidar_update_rate" value="${lidar_is_light and 10 or 12}" />
    <xacro:property name="lidar_samples" value="${lidar_is_light and 360 or 720}" />
    <xacro:property name="lidar_min_angle" value="${lidar_is_light and -1.5708 or -2.35619}" />
    <xacro:property name="lidar_max_angle" value="${lidar_is_light and 1.5708 or 2.35619}" />
    <xacro:property name="lidar_range_min" value="${lidar_is_light and 0.20 or 0.15}" />
    <xacro:property name="lidar_range_max" value="${lidar_is_light and 6.0 or 8.0}" />
    <xacro:property name="lidar_noise_stddev" value="${lidar_is_light and 0.015 or 0.01}" />
</robot>