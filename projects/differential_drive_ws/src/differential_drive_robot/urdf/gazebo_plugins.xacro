<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <gazebo reference="base_link">
        <visual>
            <material>
                <ambient>${color_base}</ambient>
                <diffuse>${color_base}</diffuse>
            </material>
        </visual>
    </gazebo>

    <gazebo reference="left_wheel_link">
        <visual>
            <material>
                <ambient>${color_wheel}</ambient>
                <diffuse>${color_wheel}</diffuse>
            </material>
        </visual>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e6</kp>
        <kd>1.0</kd>
    </gazebo>

    <gazebo reference="right_wheel_link">
        <visual>
            <material>
                <ambient>${color_wheel}</ambient>
                <diffuse>${color_wheel}</diffuse>
            </material>
        </visual>
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <kp>1e6</kp>
        <kd>1.0</kd>
    </gazebo>

    <gazebo reference="caster_link">
        <mu1>0.01</mu1>
        <mu2>0.01</mu2>
    </gazebo>

    <gazebo reference="imu_link">
        <sensor name="imu_sensor" type="imu">
            <always_on>true</always_on>
            <update_rate>100</update_rate>
            <topic>/imu</topic>
            <frame_id>imu_link</frame_id>
            <imu>
                <angular_velocity>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.0002</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.0002</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.0002</stddev>
                        </noise>
                    </z>
                </angular_velocity>
                <linear_acceleration>
                    <x>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.017</stddev>
                        </noise>
                    </x>
                    <y>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.017</stddev>
                        </noise>
                    </y>
                    <z>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.017</stddev>
                        </noise>
                    </z>
                </linear_acceleration>
            </imu>
        </sensor>
    </gazebo>

    <gazebo reference="base_link">
        <sensor name="lidar_sensor" type="gpu_lidar">
            <always_on>true</always_on>
            <visualize>true</visualize>
            <pose>0.12 0 0.11 0 0 0</pose>
            <update_rate>${lidar_update_rate}</update_rate>
            <topic>/scan</topic>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>${lidar_samples}</samples>
                        <resolution>1</resolution>
                        <min_angle>${lidar_min_angle}</min_angle>
                        <max_angle>${lidar_max_angle}</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>${lidar_range_min}</min>
                    <max>${lidar_range_max}</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>${lidar_noise_stddev}</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>

    <gazebo>
        <plugin filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find differential_drive_robot)/config/ros2_controllers.yaml</parameters>
        </plugin>
    </gazebo>

</robot>