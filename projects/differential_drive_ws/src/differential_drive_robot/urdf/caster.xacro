<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <link name="caster_link">
        <visual name="caster_tire">
            <origin xyz="0 0 ${caster_visual_axle_z}" rpy="${pi/2} 0 0" />
            <geometry>
                <cylinder radius="${caster_visual_radius}" length="${caster_visual_width}" />
            </geometry>
            <material name="black" />
        </visual>

        <visual name="caster_axle">
            <origin xyz="0 0 ${caster_visual_axle_z}" rpy="${pi/2} 0 0" />
            <geometry>
                <cylinder radius="0.002" length="${caster_visual_width + 0.006}" />
            </geometry>
            <material name="gray" />
        </visual>

        <visual name="caster_left_fork">
            <origin
                xyz="0.004 ${caster_visual_width/2 + 0.002} ${(caster_visual_axle_z + caster_fork_top_z)/2}"
                rpy="0 0 0" />
            <geometry>
                <box size="0.016 0.003 ${caster_fork_top_z - caster_visual_axle_z}" />
            </geometry>
            <material name="gray" />
        </visual>

        <visual name="caster_right_fork">
            <origin
                xyz="0.004 ${-caster_visual_width/2 - 0.002} ${(caster_visual_axle_z + caster_fork_top_z)/2}"
                rpy="0 0 0" />
            <geometry>
                <box size="0.016 0.003 ${caster_fork_top_z - caster_visual_axle_z}" />
            </geometry>
            <material name="gray" />
        </visual>

        <visual name="caster_fork_crown">
            <origin xyz="0.012 0 ${caster_fork_top_z - 0.001}" rpy="0 0 0" />
            <geometry>
                <box size="0.008 ${caster_visual_width + 0.010} 0.002" />
            </geometry>
            <material name="gray" />
        </visual>

        <visual name="caster_swivel_stem">
            <origin xyz="0.012 0 ${caster_mount_z - 0.003}" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.004" length="0.002" />
            </geometry>
            <material name="gray" />
        </visual>

        <visual name="caster_mounting_plate">
            <origin xyz="0.012 0 ${caster_mount_z - 0.001}" rpy="0 0 0" />
            <geometry>
                <box size="0.026 0.028 0.002" />
            </geometry>
            <material name="gray" />
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <sphere radius="${caster_radius}" />
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="${caster_mass}" />
            <inertia ixx="${caster_inertia_ixx}" ixy="0.0" ixz="0.0"
                iyy="${caster_inertia_iyy}" iyz="0.0"
                izz="${caster_inertia_izz}" />
        </inertial>
    </link>

    <joint name="caster_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_link" />
        <origin xyz="0.12 0 ${caster_radius - wheel_radius}" rpy="0 0 0" />
    </joint>
</robot>