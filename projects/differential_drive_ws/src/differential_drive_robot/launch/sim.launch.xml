<launch>
    <!--
            File: sim.launch.xml
            Purpose: High-level simulation entry point.
            Notes: Thin wrapper around gazebo.launch.xml that forwards common runtime args.
            Use when: you want a stable top-level command for simulation.

            Example:
            ros2 launch differential_drive_robot sim.launch.xml
        -->

    <arg name="rviz" default="true" description="Set to false to skip RViz" />
    <arg name="world_name" default="apartment"
        description="World preset: simple or apartment" />
    <arg name="world"
        default="$(find-pkg-share differential_drive_robot)/worlds/$(var world_name)_world.sdf"
        description="Full world path override (optional)" />
    <arg name="x" default="0.0" />
    <arg name="y" default="0.0" />
    <arg name="z" default="0.06" />
    <arg name="lidar_profile" default="balanced" />

    <include file="$(find-pkg-share differential_drive_robot)/launch/gazebo.launch.xml">
        <arg name="rviz" value="$(var rviz)" />
        <arg name="world" value="$(var world)" />
        <arg name="x" value="$(var x)" />
        <arg name="y" value="$(var y)" />
        <arg name="z" value="$(var z)" />
        <arg name="lidar_profile" value="$(var lidar_profile)" />
    </include>
</launch>