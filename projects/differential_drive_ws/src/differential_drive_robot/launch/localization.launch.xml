<launch>
    <!-- EKF localization fusion (wheel odom + IMU) -->
    <arg name="config_file"
        default="$(find-pkg-share differential_drive_robot)/config/ekf.yaml" />

    <node pkg="robot_localization"
        exec="ekf_node"
        name="ekf_filter_node"
        output="screen">
        <param from="$(var config_file)" />
        <param name="use_sim_time" value="true" />
    </node>
</launch>