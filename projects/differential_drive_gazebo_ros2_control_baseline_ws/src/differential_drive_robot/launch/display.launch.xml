<launch>
    <!--
            File: display.launch.xml
            Purpose: Pure RViz/URDF visualization (no Gazebo simulation).
            Use when: validating robot geometry, links, joints, and TF tree manually.

            Example:
            ros2 launch differential_drive_robot display.launch.xml
        -->

    <arg name="model"
        default="$(find-pkg-share differential_drive_robot)/urdf/differential_drive_robot.urdf.xacro" />

    <node pkg="robot_state_publisher"
        exec="robot_state_publisher"
        name="robot_state_publisher">
        <param name="robot_description"
            value="$(command 'xacro $(var model)')" />
    </node>

    <!-- Keep the GUI joint publisher active; the non-GUI publisher can overwrite the interactive
    values. -->
    <!--
    <node pkg="joint_state_publisher"
        exec="joint_state_publisher"
        name="joint_state_publisher" />
    -->

    <node pkg="joint_state_publisher_gui"
        exec="joint_state_publisher_gui"
        name="joint_state_publisher_gui" />

    <node pkg="rviz2"
        exec="rviz2"
        name="rviz2">
        <param name="rviz_config"
            value="$(find-pkg-share differential_drive_robot)/rviz/differential_drive_robot.rviz" />
    </node>
</launch>